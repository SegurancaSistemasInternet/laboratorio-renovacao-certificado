# ---------------------------------------------------------------------------
# Caddyfile do laboratório "Renovação automática de certificados, ao vivo"
# Servidor HTTPS do PortalAgenda (Cais Azul, empresa fictícia) com uma AC
# interna e certificados de vida curta, renovados sozinhos.
# ---------------------------------------------------------------------------

# Bloco de opções globais (vale para o servidor inteiro)
{
	# No Codespace não temos acesso de administrador: as portas 80 e 443
	# exigem privilégio. Usamos 8080 (HTTP) e 8443 (HTTPS).
	http_port 8080
	https_port 8443

	# Sem redirecionamento automático de HTTP para HTTPS neste laboratório
	# (ele usaria a porta 80).
	auto_https disable_redirects

	# Não tentar instalar a raiz da AC no sistema (exigiria administrador).
	# Vamos confiar nela "na mão", com o curl.
	skip_install_trust

	# A cada quanto tempo o Caddy confere se algum certificado precisa ser
	# renovado. Padrão: 10m. Reduzido para a renovação aparecer na hora certa.
	renew_interval 30s

	# Renovar quando restar 1/3 da validade, ou seja, depois de usados 2/3.
	# Este já é o padrão do Caddy; está explícito para ficar visível.
	# Se a sua versão do Caddy recusar esta linha, apague-a.
	renewal_window_ratio 0.3333

	# A AC interna do Caddy: raiz (10 anos) e intermediária (7 dias)
	pki {
		ca local {
			name "AC Cais Azul Lab"
		}
	}
}

# O site
agenda.caisazul.test:8443 {
	tls internal {
		# Validade do certificado do site. Padrão do Caddy: 12h.
		# Encurtado para 10 minutos para a renovação acontecer durante a aula
		# (por volta do minuto 6min40s, quando 2/3 da validade tiverem passado).
		lifetime 10m
	}

	# HSTS: o navegador passa a usar só HTTPS neste site por 1 ano.
	header Strict-Transport-Security "max-age=31536000"

	respond "PortalAgenda no ar. Hora do servidor: {time.now}" 200
}
